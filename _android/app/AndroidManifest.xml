<?xml version="1.0" encoding="utf-8"?>
<!-- ★ 这个文件是**版本号的唯一真相源**（3.5.0 起）：
     build.py 与 _tools/verify_apk.py 都从这里读，不再各存一份副本；
     页面里的 APP_VERSION 占位也由 build.py 注入成同一个值。
     显示版本三段 X.Y.Z = 第几代 · 第几波 · 波内第几版（3 = 界面重构时代）。
     versionCode 与显示版本解耦，只增不减：
         MAJOR*1000000 + MINOR*10000 + PATCH*100
     3.5.0 → 3050000（旧的 3.1–3.39 是 30100–33900，新方案稳压它们一头，升级不会倒挂）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yushi.app"
    android:versionCode="7020800"
    android:versionName="7.2.8">

    <!--
      零联网仍是底线，但本版破了"零权限"：为支持长按圆钮的设备端离线语音识别，加了两条权限。

      为什么加 RECORD_AUDIO（危险权限）：
        语音识别要收麦克风。它在 Android 6+ 是危险权限，首次使用会弹系统授权框，
        用户可拒绝；拒绝后页面自动降级为"弹键盘 + 提示"，不崩、不报错卡住。

      为什么加 VIBRATE（普通权限）：
        长按手势的左右区分、起手反馈都靠震动，普通权限安装即授予、无感。

      为什么仍然不声明 INTERNET（★ 5.0 起是"源文件不声明"）：
        这是纯净版的命根子 —— 鱼事是一个纯本地、不上传任何内容的待办 App。
        语音走的是 SpeechRecognizer.createOnDeviceSpeechRecognizer() 的**设备端**离线识别
        （Android 12+/API 31+），识别模型在手机本地，不经过任何服务器；
        连不上网也照常能识别。内容仍由 shouldInterceptRequest 从 APK 的 assets 直接返回，
        请求在进网络栈之前就被拦掉、不建任何 socket。所以**这个文件里** INTERNET 依旧一个字都不加。
        可用 `aapt2 dump permissions 鱼事-pure-*.apk` 当场验证：只会有 RECORD_AUDIO 和 VIBRATE。

        ★ 5.0 双包：可选的 AI 功能要联网，所以出第二个包 `鱼事-ai-*.apk`。
        实现方式是给 build.py 加一个「ai」开关（命令行上就是两个连字符加 ai），
        由它把 INTERNET 注入到**构建目录里的副本**上（见 main() 第 1 步），
        源文件这一行永远不存在 —— 纯净版因此不可能被误加权限。
        两个包同签名同版本，装机后靠文件名区分。
    -->

    <!-- 麦克风：设备端离线语音识别要用。危险权限，运行时申请，可被用户拒绝。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 震动：长按手势的左右区分反馈。普通权限，安装即授予。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- ★ 阶段1 提醒：到点弹一条系统通知。
         普通权限；Android 13(API 33)+ 同时是**运行时权限**，首次真的排出提醒时才弹系统框
         （与录音权限同一条约定：用到才问），用户拒绝也不崩、只是不弹通知，
         设置页显示「未授权 + 去设置」给他一个补救入口。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ★ 阶段1 提醒：重启后按原生持久化的排期表把提醒重排回去。
         普通权限。没有它的话，设完提醒重启手机就全丢了（真机验收第 3 项抓的就是这个）——
         因为开机广播那一刻 WebView 还没跑、页面读不到 localStorage（见硬约定 8）。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ★ 4C 真闹钟档 2：精确排期（让「9:00 提醒」真的 9:00）。
         这条**不是**运行时权限，也不是"声明了就有"：Android 12(API 31) 起它是"特殊权限"，
         Android 13(API 33) 起**新装应用默认不授予** —— 必须运行时用 canScheduleExactAlarms()
         探测，拿不到就退回原来的 set()（非精确），并用系统设置页给用户一个开启入口。
         ★ 红线：**绝不**为了让这条权限生效去降 targetSdkVersion（那是能力倒退）。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- ★ 4C：全屏响铃（锁屏上直接弹出响铃页）。
         Android 14(API 34) 起这条只自动授予"通话 / 闹钟"类应用 —— 我们大概率拿不到，
         所以**拿不到是预期结果**：那一档退化成高优先级 heads-up 通知（响铃 + 震动），
         三层降级里任何一层都必须**照样响**（红线 4：绝不允许"因为没权限所以不提醒了"）。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- ★ v3.18：INTERNET **已删除** —— 语音改成内置 Vosk 本地模型（模型就在包里，纯离线识别），
         于是又回到"一条联网权限都不声明"的零联网底线。 -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- ★ v3.12 真缺陷修复（用户实测报回错误码 5 = ERROR_CLIENT）：
         Android 11(API 30) 起有「包可见性」限制 —— 不声明这条 queries，app 就**看不见**
         系统的语音识别服务，createSpeechRecognizer() 绑不上，startListening 直接回
         ERROR_CLIENT(5)。这不是设备问题，是清单里少了一行。 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="false"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ★ 4C 真闹钟档 2：全屏响铃页（只有拿到 USE_FULL_SCREEN_INTENT 时才会被拉起来）。
             它同样是 MainActivity 的**静态嵌套类**（写入范围只授权 MainActivity.java），
             所以名字里带 $。exported="false"：只有本应用通过 PendingIntent 显式拉起它。
             showWhenLocked / turnScreenOn 让它在锁屏、熄屏时也能直接弹出来。 -->
        <activity
            android:name="com.yushi.app.MainActivity$AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale" />

        <!-- ★ 阶段1 提醒：到点弹通知 + 开机重排，同一个 receiver 干两件事。
             它是 MainActivity 的**静态嵌套类**（本轮的写入范围只授权了 MainActivity.java
             一个 Java 文件），所以名字里带 $。
             exported="false" 是安全的：BOOT_COMPLETED / MY_PACKAGE_REPLACED 都是系统广播，
             系统被允许投递给非导出的接收器；而到点那个 action 是**显式** Intent
             （组件名写死在 PendingIntent 里），同应用内投递更不受导出限制。
             没有它，重启手机后提醒全丢（见 RECEIVE_BOOT_COMPLETED 那段说明）。 -->
        <receiver
            android:name="com.yushi.app.MainActivity$NotifyReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- 部分国产 ROM 的"快速开机"广播，多收一个不吃亏 -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
