<?xml version="1.0" encoding="utf-8"?>
<!-- ★ 这个文件是**版本号的唯一真相源**（3.5.0 起）：
     build.py 与 _tools/verify_apk.py 都从这里读，不再各存一份副本；
     页面里的 APP_VERSION 占位也由 build.py 注入成同一个值。
     显示版本三段 X.Y.Z = 第几代 · 第几波 · 波内第几版（3 = 界面重构时代）。
     versionCode 与显示版本解耦，只增不减：
         MAJOR*1000000 + MINOR*10000 + PATCH*100
     3.5.0 → 3050000（旧的 3.1–3.39 是 30100–33900，新方案稳压它们一头，升级不会倒挂）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yushi.app"
    android:versionCode="3050600"
    android:versionName="3.5.6">

    <!--
      零联网仍是底线，但本版破了"零权限"：为支持长按圆钮的设备端离线语音识别，加了两条权限。

      为什么加 RECORD_AUDIO（危险权限）：
        语音识别要收麦克风。它在 Android 6+ 是危险权限，首次使用会弹系统授权框，
        用户可拒绝；拒绝后页面自动降级为"弹键盘 + 提示"，不崩、不报错卡住。

      为什么加 VIBRATE（普通权限）：
        长按手势的左右区分、起手反馈都靠震动，普通权限安装即授予、无感。

      为什么仍然不声明 INTERNET：
        这是本项目的命根子 —— 鱼事是一个纯本地、不上传任何内容的待办 App。
        语音走的是 SpeechRecognizer.createOnDeviceSpeechRecognizer() 的**设备端**离线识别
        （Android 12+/API 31+），识别模型在手机本地，不经过任何服务器；
        连不上网也照常能识别。内容仍由 shouldInterceptRequest 从 APK 的 assets 直接返回，
        请求在进网络栈之前就被拦掉、不建任何 socket。所以 INTERNET 依旧一个字都不加。
        可用 `aapt2 dump permissions 鱼事.apk` 当场验证：只会有 RECORD_AUDIO 和 VIBRATE。
    -->

    <!-- 麦克风：设备端离线语音识别要用。危险权限，运行时申请，可被用户拒绝。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 震动：长按手势的左右区分反馈。普通权限，安装即授予。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- ★ v3.18：INTERNET **已删除** —— 语音改成内置 Vosk 本地模型（模型就在包里，纯离线识别），
         于是又回到"一条联网权限都不声明"的零联网底线。 -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- ★ v3.12 真缺陷修复（用户实测报回错误码 5 = ERROR_CLIENT）：
         Android 11(API 30) 起有「包可见性」限制 —— 不声明这条 queries，app 就**看不见**
         系统的语音识别服务，createSpeechRecognizer() 绑不上，startListening 直接回
         ERROR_CLIENT(5)。这不是设备问题，是清单里少了一行。 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="false"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
